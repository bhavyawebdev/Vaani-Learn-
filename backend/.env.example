# =========================================================================
# VAANILEARN AI — GNANI AI INTERNSHIP CHALLENGE
# Environment Configuration Template
# =========================================================================
# Copy this file to '.env' and fill in your credentials.
# NOTE: '.env' is ignored in git to ensure secret tokens are never exposed.

# -------------------------------------------------------------------------
# 1. SUPABASE (PostgreSQL + pgvector + Auth + Storage)
# -------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Settings -> API & Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-admin-key
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_STORAGE_BUCKET=study-materials

# -------------------------------------------------------------------------
# 2. GOOGLE GEMINI API (Free Tier Reasoning)
# -------------------------------------------------------------------------
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# -------------------------------------------------------------------------
# 3. GNANI AI (Unified Speech-to-Text & Text-to-Speech API)
# -------------------------------------------------------------------------
# Single API Key used for both Gnani STT and TTS engines
GNANI_API_KEY=your-gnani-api-key-here

# -------------------------------------------------------------------------
# 5. BACKEND FASTAPI CONFIGURATION
# -------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -------------------------------------------------------------------------
# 6. FRONTEND VITE (React + TypeScript)
# -------------------------------------------------------------------------
# Vite exposes variables prefixed with VITE_ to the client browser
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
VITE_API_URL=http://localhost:8000/api/v1
